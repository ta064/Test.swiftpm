# LinkedIn API認証情報
# このファイルを .env にコピーして実際の値を設定してください

# LinkedInアクセストークン
# 取得方法: https://www.linkedin.com/developers/ でアプリを作成し、OAuth 2.0で取得
export LINKEDIN_ACCESS_TOKEN="your_access_token_here"

# LinkedIn著者ID (Person URN)
# 取得方法: curl -X GET 'https://api.linkedin.com/v2/me' -H 'Authorization: Bearer YOUR_ACCESS_TOKEN'
# レスポンスのidフィールドの値を使用
export LINKEDIN_AUTHOR_ID="your_person_urn_here"

# 使用方法:
# 1. このファイルを .env にコピー: cp .env.example .env
# 2. .env を編集して実際の値を設定
# 3. 環境変数を読み込み: source .env
# 4. アプリを実行: swift run
